# Supply credentials locally; never commit the completed environment file.
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PORT=5432

# URL-encode database passwords. These URLs use Docker's internal hostname.
DB_URL=postgresql+asyncpg://identity_app:URL_ENCODED_PASSWORD@postgres:5432/identity
BFF_DB_URL=postgresql+asyncpg://bff_app:URL_ENCODED_PASSWORD@postgres:5432/bff

DOMAIN=example.uk
BFF_PUBLIC_ORIGIN=https://example.uk
# Absolute WSL path containing tls.crt and tls.key, readable by nginx UID 101.
NGINX_CERTS_DIR=
HTTPS_PORT=443

JWT_ISSUER=https://example.uk
JWT_AUDIENCE=your-applications
IDENTITY_TOKEN_HMAC_KEY=
BFF_SESSION_HMAC_KEY=
# Comma-separated Fernet keys; generate independently of the HMAC secrets.
BFF_TOKEN_ENCRYPTION_KEYS=

SMTP_HOST=
SMTP_PORT=1025
IDENTITY_EMAIL_FROM=
WEBAUTHN_RP_ID=example.uk
WEBAUTHN_RP_NAME=Identity
WEBAUTHN_ORIGIN=https://example.uk

# Optional JSON mapping, for example {"canonforge":"http://canonforge:8000"}.
# Application containers must share this Compose project's network.
BFF_UPSTREAMS={}
