# Runtime settings. Container DNS names below assume the services share a network.
BFF_DB_URL=postgresql+asyncpg://bff_app:URL_ENCODED_PASSWORD@postgres:5432/bff
BFF_PUBLIC_ORIGIN=https://example.uk
BFF_IDENTITY_BASE_URL=http://identity:8000

# Supply your own independent secret (at least 32 bytes).
BFF_SESSION_HMAC_KEY=
# Comma-separated Fernet keys: URL-safe base64 of 32 random bytes each.
# First key encrypts new tokens; remaining keys allow older tokens to decrypt.
BFF_TOKEN_ENCRYPTION_KEYS=

# Optional: fixed internal origins only. BFF has no default application upstreams.
BFF_UPSTREAMS={}

# Used only by Alembic, never by the running BFF.
POSTGRES_BFF_MIGRATOR_URL=postgresql+asyncpg://bff_migrator:URL_ENCODED_PASSWORD@localhost:5432/bff
